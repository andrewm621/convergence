{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Condition",
  "description": "An evaluated state on a work item, with the reason codes that explain it.",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "#/$defs/ConditionType"
    },
    "workItemId": {
      "$ref": "#/$defs/WorkItemId"
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReasonCode"
      }
    },
    "recordRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facetKeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FacetKey"
      }
    },
    "message": {
      "type": "string"
    },
    "observedAt": {
      "$ref": "#/$defs/IsoTimestamp"
    }
  },
  "required": [
    "type",
    "workItemId",
    "reasonCodes",
    "recordRefs",
    "facetKeys",
    "message",
    "observedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "ConditionType": {
      "type": "string",
      "enum": [
        "Fresh",
        "Stale",
        "Uncertain",
        "ClaimConflict",
        "TestFailed",
        "TestsPassed",
        "Blocked",
        "Ready",
        "Promoted"
      ]
    },
    "WorkItemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "STALE_RECEIPT",
        "FACET_CHANGED",
        "PROSE_ONLY",
        "NO_DEPENDENCY_ON_CHANGED_FACETS",
        "ALREADY_PROMOTED",
        "NO_CONTEXT_CHANGE",
        "VERSION_NOT_NEWER",
        "IMMUTABLE_VERSION",
        "RECORD_NOT_ACCEPTED",
        "UNKNOWN_CONTEXT_VERSION",
        "NO_CLAIMS",
        "MALFORMED_CLAIMS",
        "CLAIM_CONFLICT",
        "SUPERSEDED_BASIS",
        "CROSS_CLAIM_CONFLICT",
        "UNDECLARED_DEP",
        "FORK_CONTEXT_IGNORED",
        "FORK_EDITS_CONTEXT",
        "WRONG_RECORD",
        "TEST_FAILED",
        "MISSING_EVIDENCE",
        "HUMAN_RESOLUTION_MISSING",
        "UNRESOLVED_DEPENDENCY",
        "REVALIDATION_PENDING",
        "UNKNOWN_WORK_ITEM",
        "NOT_FRESH",
        "REVALIDATION_LIMIT",
        "REVALIDATION_STARTED",
        "RECEIPT_MISMATCH",
        "REVALIDATION_NOT_REQUESTED",
        "NOTHING_TO_REVALIDATE",
        "REVALIDATION_IN_PROGRESS",
        "FORBIDDEN_ACTOR",
        "STALE_BINDING",
        "BASELINE_MOVED",
        "HEAD_MOVED",
        "EXCEPTION_LAPSED",
        "EXCEPTION_APPLIED",
        "PROMOTION_NOT_APPROVED",
        "STALE_EVIDENCE",
        "TESTS_PASSED",
        "DUPLICATE_EVENT",
        "IDEMPOTENCY_CONFLICT",
        "OBSERVATION_ONLY",
        "DEPENDENCY_DECIDED",
        "ALREADY_RESOLVED",
        "RESOLUTION_REJECTED"
      ]
    },
    "FacetKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
