{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy",
  "description": "The versioned rules a cell runs under: who is the authority for each record, staleness mode, global requirements, revalidation limit.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authority": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Slug"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "staleness": {
      "type": "string",
      "enum": [
        "facet",
        "record"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Requirement"
      }
    },
    "maxRevalidations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "authority",
    "staleness",
    "requires",
    "maxRevalidations"
  ],
  "additionalProperties": false,
  "$defs": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "Requirement": {
      "type": "string",
      "enum": [
        "contract-test",
        "human-resolution"
      ]
    }
  }
}
