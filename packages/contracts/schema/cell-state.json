{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CellState",
  "description": "The whole state of one workspace cell. Plain JSON; reconcile is a pure function of this, an event and a policy.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "baselineCommit": {
      "$ref": "#/$defs/CommitSha"
    },
    "snapshotHash": {
      "$ref": "#/$defs/Sha256"
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Slug"
      },
      "additionalProperties": {
        "$ref": "#/$defs/RecordHistory"
      }
    },
    "workItems": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/WorkItemState"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dependency"
      }
    },
    "processed": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "baselineCommit",
    "snapshotHash",
    "records",
    "workItems",
    "dependencies",
    "processed"
  ],
  "additionalProperties": false,
  "$defs": {
    "CommitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "RecordHistory": {
      "type": "object",
      "properties": {
        "current": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/RecordSnapshot"
          }
        },
        "proposed": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "current",
        "versions",
        "proposed"
      ],
      "additionalProperties": false
    },
    "RecordSnapshot": {
      "type": "object",
      "properties": {
        "recordId": {
          "$ref": "#/$defs/Slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "#/$defs/RecordStatus"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "acceptedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "facets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/FacetKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FacetValue"
          }
        },
        "not": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/FacetKey"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/FacetScalar"
            }
          }
        },
        "blobHash": {
          "$ref": "#/$defs/ObjectHash"
        },
        "facetHash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "recordId",
        "version",
        "status",
        "authority",
        "acceptedBy",
        "acceptedAt",
        "validation",
        "facets",
        "not",
        "blobHash",
        "facetHash"
      ],
      "additionalProperties": false
    },
    "RecordStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ]
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "FacetKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "FacetValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/FacetScalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetScalar"
          }
        }
      ]
    },
    "FacetScalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "ObjectHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "WorkItemState": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/WorkItem"
        },
        "receipt": {
          "$ref": "#/$defs/ContextReceipt"
        },
        "headSha": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimsState"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "revalidations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revalidating": {
          "type": "boolean"
        },
        "revalidationRun": {
          "type": "string",
          "minLength": 1
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resolution"
          }
        },
        "promotionApproval": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromotionApproval"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "item",
        "receipt",
        "headSha",
        "claims",
        "evidence",
        "conditions",
        "revalidations",
        "revalidating",
        "resolutions",
        "promotionApproval"
      ],
      "additionalProperties": false
    },
    "WorkItem": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "forkRepo": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "live",
            "seeded"
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "delivery",
            "exploratory"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          }
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Actor"
          }
        }
      },
      "required": [
        "id",
        "title",
        "actor",
        "forkRepo",
        "source",
        "intent",
        "requires",
        "status"
      ],
      "additionalProperties": false
    },
    "WorkItemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "Actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "string",
      "enum": [
        "contract-test",
        "human-resolution"
      ]
    },
    "WorkItemStatus": {
      "type": "string",
      "enum": [
        "running",
        "fresh",
        "stale",
        "uncertain",
        "conflict",
        "revalidating",
        "ready",
        "promoted",
        "rejected"
      ]
    },
    "ContextReceipt": {
      "type": "object",
      "properties": {
        "baselineCommit": {
          "$ref": "#/$defs/CommitSha"
        },
        "contextPacketHash": {
          "$ref": "#/$defs/Sha256"
        },
        "accepted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReceiptEntry"
          }
        },
        "proposedVisible": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextSnapshotEntry"
          }
        },
        "noteRef": {
          "$ref": "#/$defs/NoteRef"
        }
      },
      "required": [
        "baselineCommit",
        "contextPacketHash",
        "accepted",
        "proposedVisible"
      ],
      "additionalProperties": false
    },
    "ReceiptEntry": {
      "type": "object",
      "properties": {
        "recordId": {
          "$ref": "#/$defs/Slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "blobHash": {
          "$ref": "#/$defs/ObjectHash"
        },
        "facetHash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "recordId",
        "version",
        "blobHash",
        "facetHash"
      ],
      "additionalProperties": false
    },
    "ContextSnapshotEntry": {
      "type": "object",
      "properties": {
        "recordId": {
          "$ref": "#/$defs/Slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "blobHash": {
          "$ref": "#/$defs/ObjectHash"
        }
      },
      "required": [
        "recordId",
        "version",
        "blobHash"
      ],
      "additionalProperties": false
    },
    "NoteRef": {
      "type": "string",
      "pattern": "^refs\\/notes\\/delta:(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "ClaimsState": {
      "type": "object",
      "properties": {
        "headSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "missing",
            "malformed"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "headSha",
        "status",
        "claims",
        "error"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/FacetKey"
        },
        "value": {
          "$ref": "#/$defs/FacetValue"
        },
        "basedOn": {
          "$ref": "#/$defs/RecordRefString"
        }
      },
      "required": [
        "subject",
        "value",
        "basedOn"
      ],
      "additionalProperties": false
    },
    "RecordRefString": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*@[1-9][0-9]*$"
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "workItemId": {
          "$ref": "#/$defs/WorkItemId"
        },
        "headSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "pass": {
          "type": "boolean"
        },
        "output": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        }
      },
      "required": [
        "workItemId",
        "headSha",
        "check",
        "pass",
        "output"
      ],
      "additionalProperties": false
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "executed-test",
        "delta-run-check",
        "delta-claims-check"
      ]
    },
    "Condition": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ConditionType"
        },
        "workItemId": {
          "$ref": "#/$defs/WorkItemId"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasonCode"
          }
        },
        "recordRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facetKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetKey"
          }
        },
        "message": {
          "type": "string"
        },
        "observedAt": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      },
      "required": [
        "type",
        "workItemId",
        "reasonCodes",
        "recordRefs",
        "facetKeys",
        "message",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "ConditionType": {
      "type": "string",
      "enum": [
        "Fresh",
        "Stale",
        "Uncertain",
        "ClaimConflict",
        "TestFailed",
        "TestsPassed",
        "Blocked",
        "Ready",
        "Promoted"
      ]
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "STALE_RECEIPT",
        "FACET_CHANGED",
        "PROSE_ONLY",
        "NO_DEPENDENCY_ON_CHANGED_FACETS",
        "ALREADY_PROMOTED",
        "NO_CONTEXT_CHANGE",
        "VERSION_NOT_NEWER",
        "IMMUTABLE_VERSION",
        "RECORD_NOT_ACCEPTED",
        "UNKNOWN_CONTEXT_VERSION",
        "NO_CLAIMS",
        "MALFORMED_CLAIMS",
        "CLAIM_CONFLICT",
        "SUPERSEDED_BASIS",
        "CROSS_CLAIM_CONFLICT",
        "UNDECLARED_DEP",
        "FORK_CONTEXT_IGNORED",
        "FORK_EDITS_CONTEXT",
        "WRONG_RECORD",
        "TEST_FAILED",
        "MISSING_EVIDENCE",
        "HUMAN_RESOLUTION_MISSING",
        "UNRESOLVED_DEPENDENCY",
        "REVALIDATION_PENDING",
        "UNKNOWN_WORK_ITEM",
        "NOT_FRESH",
        "REVALIDATION_LIMIT",
        "REVALIDATION_STARTED",
        "RECEIPT_MISMATCH",
        "REVALIDATION_NOT_REQUESTED",
        "NOTHING_TO_REVALIDATE",
        "REVALIDATION_IN_PROGRESS",
        "FORBIDDEN_ACTOR",
        "STALE_BINDING",
        "BASELINE_MOVED",
        "HEAD_MOVED",
        "EXCEPTION_LAPSED",
        "EXCEPTION_APPLIED",
        "PROMOTION_NOT_APPROVED",
        "STALE_EVIDENCE",
        "TESTS_PASSED",
        "DUPLICATE_EVENT",
        "IDEMPOTENCY_CONFLICT",
        "OBSERVATION_ONLY",
        "DEPENDENCY_DECIDED",
        "ALREADY_RESOLVED",
        "RESOLUTION_REJECTED"
      ]
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "revalidate",
            "accept-exception",
            "reject"
          ]
        },
        "workItemId": {
          "$ref": "#/$defs/WorkItemId"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "$ref": "#/$defs/ResolutionBinding"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "ts": {
          "$ref": "#/$defs/IsoTimestamp"
        }
      },
      "required": [
        "kind",
        "workItemId",
        "actor",
        "rationale",
        "binding",
        "ts"
      ],
      "additionalProperties": false,
      "description": "A human disposition of a work item, bound to the exact context and fork head it was made against. Not expressed here: rationale and scope are trimmed before validation, so whitespace-only text fails Zod even though it passes JSON Schema, and scope is required when kind is accept-exception."
    },
    "ResolutionBinding": {
      "type": "object",
      "properties": {
        "recordId": {
          "$ref": "#/$defs/Slug"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "blobHash": {
          "$ref": "#/$defs/ObjectHash"
        },
        "baseSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "forkHeadSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "contextSnapshotHash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "recordId",
        "version",
        "blobHash",
        "baseSha",
        "forkHeadSha",
        "contextSnapshotHash"
      ],
      "additionalProperties": false
    },
    "PromotionApproval": {
      "type": "object",
      "properties": {
        "forkHeadSha": {
          "$ref": "#/$defs/CommitSha"
        },
        "baselineCommit": {
          "$ref": "#/$defs/CommitSha"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": [
        "forkHeadSha",
        "baselineCommit",
        "requestId"
      ],
      "additionalProperties": false
    },
    "Dependency": {
      "type": "object",
      "properties": {
        "workItemId": {
          "$ref": "#/$defs/WorkItemId"
        },
        "recordId": {
          "$ref": "#/$defs/Slug"
        },
        "facetKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetKey"
          }
        },
        "basis": {
          "type": "string",
          "enum": [
            "declared",
            "verified",
            "inferred"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "workItemId",
        "recordId",
        "facetKeys",
        "basis",
        "status",
        "evidenceRefs"
      ],
      "additionalProperties": false
    }
  }
}
