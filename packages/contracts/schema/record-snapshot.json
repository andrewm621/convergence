{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordSnapshot",
  "description": "A parsed, hashed context record as the reconciler sees it (carried by BaselinePushed and held in the cell state).",
  "type": "object",
  "properties": {
    "recordId": {
      "$ref": "#/$defs/Slug"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "$ref": "#/$defs/RecordStatus"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "acceptedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/IsoTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "facets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/FacetKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/FacetValue"
      }
    },
    "not": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/FacetKey"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/FacetScalar"
        }
      }
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "blobHash": {
      "$ref": "#/$defs/ObjectHash"
    },
    "facetHash": {
      "$ref": "#/$defs/Sha256"
    }
  },
  "required": [
    "recordId",
    "version",
    "status",
    "authority",
    "acceptedBy",
    "acceptedAt",
    "validation",
    "facets",
    "not",
    "blobHash",
    "facetHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "RecordStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ]
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "FacetKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "FacetValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/FacetScalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FacetScalar"
          }
        }
      ]
    },
    "FacetScalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "ObjectHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
