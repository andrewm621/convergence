{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "description": "The result of a check at a specific head of a work item's fork.",
  "type": "object",
  "properties": {
    "workItemId": {
      "$ref": "#/$defs/WorkItemId"
    },
    "headSha": {
      "$ref": "#/$defs/CommitSha"
    },
    "check": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "output": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    }
  },
  "required": [
    "workItemId",
    "headSha",
    "check",
    "pass",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "WorkItemId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "executed-test",
        "delta-run-check",
        "delta-claims-check"
      ]
    }
  }
}
