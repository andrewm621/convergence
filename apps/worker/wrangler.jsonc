{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delta-convergence",
  // No account_id on purpose: wrangler takes it from CLOUDFLARE_ACCOUNT_ID (gitignored .env).
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The console is served from the Worker as static assets: build it first with `pnpm build:console`.
  // run_worker_first keeps /api/* (REST and the WebSocket) and /health on the Worker; everything else
  // is an asset, and an unknown path falls back to index.html so the SPA owns its URLs.
  "assets": {
    "directory": "../console/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    "APP_VERSION": "0.0.1",
    // Smoke endpoints create and delete real repos. Off by default; deploy with --var ENABLE_SMOKE:1 to use them.
    "ENABLE_SMOKE": "0",
    // stub = scripted agent (no model key needed); claude = Claude Code headless through OpenRouter.
    "AGENT_MODE": "stub",
    // OpenRouter model slug Claude Code is pinned to by default (only read when AGENT_MODE=claude). Claude Sonnet completed every
    // live run on Oct 14 (about $0.60 per run); cheaper models failed intermittently with unrecognized_model or stalled.
    "AGENT_MODEL": "anthropic/claude-sonnet-5.5",
    // Other OpenRouter slugs a dispatch may select with {"model": ...}. AGENT_MODEL is always allowed. Each run is pinned to its model at the gateway.
    "AGENT_MODELS": "minimax/minimax-m3,openai/gpt-6-luna",
    // Claude Code's own caps for AGENT_MODE=claude. Its dollar estimate prices every model at Anthropic rates (about 50x too high for
    // a cheap model), so AGENT_MAX_BUDGET_USD is only a loose backstop; the real dollar cap is AGENT_MAX_COST_USD, enforced by the gateway.
    "AGENT_MAX_TURNS": "15",
    "AGENT_MAX_BUDGET_USD": "5",
    "AGENT_TIMEOUT_S": "600",
    // Enforced by the gateways (not the agent) on every run: request counts, total tokens, and per-request max_tokens.
    "AGENT_MAX_MODEL_REQUESTS": "40",
    "AGENT_MAX_GIT_REQUESTS": "60",
    "AGENT_MAX_TOTAL_TOKENS": "1000000",
    "AGENT_MAX_OUTPUT_TOKENS": "8192",
    // Dollars per run, summed from the cost OpenRouter reports in each response. A cheap model costs a cent or two; a stronger one on camera
    // (the shelter act) needs about a dollar of headroom. The code default is 0.25.
    "AGENT_MAX_COST_USD": "2.00",
    // Pause between stub steps so concurrent runs visibly overlap.
    "STUB_STEP_MS": "2500",
    // Container size. "lite" runs the stub but is CPU-starved (about 2x slower end to end); claude needs standard-1 or larger.
    "SANDBOX_INSTANCE": "standard-1",
    // How often a WorkspaceCell polls its repos through the Artifacts binding (ms, 100-60000).
    "POLL_INTERVAL_MS": "3000",
    // Opt-in public read-only view: comma-separated cell names (as in /api/scenarios/:name) whose state, ledger and per-item gate
    // anyone may GET without the bearer token. Empty = every /api route needs the token, as before. Set it at deploy time
    // (--var PUBLIC_READ_SCENARIOS:name1,name2); nothing else is opened, and every write still needs the token.
    "PUBLIC_READ_SCENARIOS": "",
    // The one human the bearer secret stands for. Must match the authority in the scenario's policy.
    "DEMO_ACTOR_ID": "decision-owner",
    "DEMO_ACTOR_NAME": "Decision owner (demo identity)"
  },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "default" }],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_CELL", "class_name": "WorkspaceCell" },
      { "name": "AGENT_SANDBOX", "class_name": "AgentSandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceCell"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentSandbox"] }
  ],
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": { "agent": { "dockerfile": "./container/Dockerfile" } }
    }
  ],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put <NAME>; locally apps/worker/.dev.vars):
  //   DEV_TOKEN          bearer token for /api/*
  //   OPENROUTER_API_KEY only for AGENT_MODE=claude
}
